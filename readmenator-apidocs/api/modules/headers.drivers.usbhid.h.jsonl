{"uid":"headers/drivers/usbhid.h::usbhid_press_kbd_report","name":"usbhid_press_kbd_report","qualname":"usbhid_press_kbd_report","kind":"function","file":"headers/drivers/usbhid.h","line":84,"end_line":84,"language":"h","signature":"int usbhid_press_kbd_report(const unsigned char report[HID_KBD_REPORT_LEN]);","params":[{"name":"HID_KBD_REPORT_LEN","annotation":"unsigned char report[ ]","default":"","kind":"positional"}],"returns":"int","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Docstring: Feed a boot keyboard report through the differ, for the host test and the in-OS self test.","description":"Uses the first claimed keyboard's stored previous report and updates it. Returns the scancodes emitted.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"headers/drivers/usbhid.h","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
{"uid":"headers/drivers/usbhid.h::usbhid_kbd_scancodes","name":"usbhid_kbd_scancodes","qualname":"usbhid_kbd_scancodes","kind":"function","file":"headers/drivers/usbhid.h","line":94,"end_line":94,"language":"h","signature":"int usbhid_kbd_scancodes(const unsigned char prev[HID_KBD_REPORT_LEN], const unsigned char cur[HID_KBD_REPORT_LEN], unsigned char *out, int max);","params":[{"name":"HID_KBD_REPORT_LEN","annotation":"unsigned char prev[ ]","default":"","kind":"positional"},{"name":"HID_KBD_REPORT_LEN","annotation":"unsigned char cur[ ]","default":"","kind":"positional"},{"name":"out","annotation":"unsigned char *","default":"","kind":"positional"},{"name":"max","annotation":"int","default":"","kind":"positional"}],"returns":"int","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Docstring: Set-1 scancode stream for one keyboard report transition.","description":"Pure: no hardware, no kernel state, no allocation, which is what makes it\nhost-testable. Breaks are emitted before makes, for modifiers and for keys\nalike, so a burst never reads as a held-key repeat. A key that merely moved\nslot within the array produces nothing, because the array order is the\ndevice's choice. Returns the number of scancodes written, which is less\nthan max only when the report produced no events.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"headers/drivers/usbhid.h","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
{"uid":"headers/drivers/usbhid.h::usbhid_mouse_decode","name":"usbhid_mouse_decode","qualname":"usbhid_mouse_decode","kind":"function","file":"headers/drivers/usbhid.h","line":102,"end_line":102,"language":"h","signature":"void usbhid_mouse_decode(const unsigned char prev[HID_MOUSE_REPORT_LEN], const unsigned char cur[HID_MOUSE_REPORT_LEN], int *dx, int *dy, int *buttons, int *wheel);","params":[{"name":"HID_MOUSE_REPORT_LEN","annotation":"unsigned char prev[ ]","default":"","kind":"positional"},{"name":"HID_MOUSE_REPORT_LEN","annotation":"unsigned char cur[ ]","default":"","kind":"positional"},{"name":"dx","annotation":"int *","default":"","kind":"positional"},{"name":"dy","annotation":"int *","default":"","kind":"positional"},{"name":"buttons","annotation":"int *","default":"","kind":"positional"},{"name":"wheel","annotation":"int *","default":"","kind":"positional"}],"returns":"void","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Docstring: Decode one boot mouse report transition into screen-space motion, buttons and wheel.","description":"Pure, for the same reason. dx and dy are raw report deltas; the caller applies the motion scale, matching the PS/2 path so both sources move the pointer identically.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"headers/drivers/usbhid.h","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
