{"uid":"kernel/ed25519.c::ed25519_verify","name":"ed25519_verify","qualname":"ed25519_verify","kind":"function","file":"kernel/ed25519.c","line":810,"end_line":887,"language":"c","signature":"int ed25519_verify(const unsigned char sig[64], const unsigned char *msg, unsigned long msglen, const unsigned char pub[32])","params":[{"name":"sig","annotation":"unsigned char [64]","default":"","kind":"positional"},{"name":"msg","annotation":"unsigned char *","default":"","kind":"positional"},{"name":"msglen","annotation":"unsigned long","default":"","kind":"positional"},{"name":"pub","annotation":"unsigned char [32]","default":"","kind":"positional"}],"returns":"int","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Docstring: Verify an Ed25519 signature, 1 valid else 0 fail-closed.","description":"Rejects S at or above L and non-canonical R/A encodings before any\ncurve work, then checks [S]B minus [h]A against R by\ncross-multiplied projective comparison, so no inversion touches\nthe hot path. Null inputs refuse.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"kernel/ed25519.c","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":["kernel/ed25519.c::ed_sha512_final","kernel/ed25519.c::ed_sha512_init","kernel/ed25519.c::ed_sha512_update"],"called_by":[]}
