{"uid":"mcp/minios_addons.py","name":"minios_addons.py","qualname":"mcp/minios_addons.py","kind":"module","file":"mcp/minios_addons.py","line":1,"end_line":528,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"MiniOS addon marketplace (lazyaddons-style).","description":"Addons are YAML files that say where a program's source lives on GitHub and\nhow it is built. Two flavors share one dialect:\n\n- kind `guest` (default): built *inside* the OS. This module parses that\n  YAML with a strict stdlib-only subset parser (no PyYAML) and installs\n  the addon into a running MiniOS session: clone the repo, upload each\n  source through the editor in bounded chunks, reassemble with `cat`,\n  build and verify inside the OS.\n- kind `host`: built on the host with the ordinary gcc toolchain and\n  packed into the image by `make` (every sibling checkout and every\n  vendored tree). `minios_install` refuses these with a diagnostic that\n  names the make target instead of half-installing them.\n- kind `reference`: source-only reference checkouts (never vendored,\n  never linked, never built). Same refusal as `host`.\n\nThe host shell is never invoked; the only commands run are the addon's own\nbuild/verify lines, driven line by line through the MiniOS shell.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["mcp/minios_addons.py::ADDON_MAX_NAME","mcp/minios_addons.py::ADDON_MAX_DESC","mcp/minios_addons.py::ADDON_MAX_ITEMS","mcp/minios_addons.py::ADDON_LINE_MAX","mcp/minios_addons.py::ADDON_PATH_CHARS","mcp/minios_addons.py::ADDON_KEYS","mcp/minios_addons.py::ADDON_INSTALL_KEYS","mcp/minios_addons.py::ADDON_KINDS","mcp/minios_addons.py::ADDON_META_MAX","mcp/minios_addons.py::ADDON_REGISTRY_PATH","mcp/minios_addons.py::ADDON_TMO_CLONE_S","mcp/minios_addons.py::ADDON_TMO_SHELL_MS","mcp/minios_addons.py::ADDON_CHUNK_LINES","mcp/minios_addons.py::ADDON_CHUNK_LINE_MAX","mcp/minios_addons.py::AddonError","mcp/minios_addons.py::parse_addon_yaml","mcp/minios_addons.py::validate_addon","mcp/minios_addons.py::validate_addon_path","mcp/minios_addons.py::validate_shell_line","mcp/minios_addons.py::load_addons_dir","mcp/minios_addons.py::split_for_editor","mcp/minios_addons.py::exit_code_of","mcp/minios_addons.py::AddonState","mcp/minios_addons.py::install_addon"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
