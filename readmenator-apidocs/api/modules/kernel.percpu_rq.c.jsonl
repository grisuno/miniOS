{"uid":"kernel/percpu_rq.c::rq_steal_once","name":"rq_steal_once","qualname":"rq_steal_once","kind":"function","file":"kernel/percpu_rq.c","line":89,"end_line":112,"language":"c","signature":"int rq_steal_once(int self_cpu, int *from_cpu)","params":[{"name":"self_cpu","annotation":"int","default":"","kind":"positional"},{"name":"from_cpu","annotation":"int *","default":"","kind":"positional"}],"returns":"int","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Docstring: Non-blocking steal of one hint from another CPU's ring.","description":"Tries every remote ring once with spin_trylock and returns the first\nhint found, reporting the donor through from_cpu. Rings that are busy\nare skipped, never waited on. Returns WQ_NONE_HINT when nothing could\nbe stolen without blocking. The thief's steal counter is owner-written\nbut updated under the donor's lock, so it uses an atomic add (the same\npattern as smp_dispatches) instead of relying on the donor's lock.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"kernel/percpu_rq.c","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":["headers/spinlock.h::spin_trylock","headers/spinlock.h::spin_unlock"],"called_by":[]}
