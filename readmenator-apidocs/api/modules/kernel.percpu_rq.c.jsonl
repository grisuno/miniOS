{"uid":"kernel/percpu_rq.c::rq_enqueue","name":"rq_enqueue","qualname":"rq_enqueue","kind":"function","file":"kernel/percpu_rq.c","line":41,"end_line":58,"language":"c","signature":"void rq_enqueue(int cpu, int pid)","params":[{"name":"cpu","annotation":"int","default":"","kind":"positional"},{"name":"pid","annotation":"int","default":"","kind":"positional"}],"returns":"void","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Docstring: Record pid as READY work for cpu.","description":"Lossy by contract: a full ring drops the hint and counts the drop. The\nglobal scan remains the fallback, so a drop costs one rescan period of\nlatency at most, never correctness. Pids outside the table are refused.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"kernel/percpu_rq.c","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":["headers/spinlock.h::spin_lock_irqsave","headers/spinlock.h::spin_unlock_irqrestore"],"called_by":[]}
