{"uid":"headers/wm_dock.h::wm_dock_level","name":"wm_dock_level","qualname":"wm_dock_level","kind":"function","file":"headers/wm_dock.h","line":61,"end_line":71,"language":"h","signature":"static inline int wm_dock_level(int from, int rising, unsigned long elapsed, unsigned long duration)","params":[{"name":"from","annotation":"int","default":"","kind":"positional"},{"name":"rising","annotation":"int","default":"","kind":"positional"},{"name":"elapsed","annotation":"unsigned long","default":"","kind":"positional"},{"name":"duration","annotation":"unsigned long","default":"","kind":"positional"}],"returns":"int","decorators":[],"bases":[],"modifiers":["inline","static"],"visibility":"public","doc":{"summary":"Docstring: Magnification level after elapsed ticks of a ramp that started at from: rising toward WM_DOCK_LEVEL_ONE or falling toward 0, linear over duration ticks for the full span.","description":"A non-positive duration jumps to the target.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"headers/wm_dock.h","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":["headers/wm_dock.h::wm_dock_level_clamp"],"called_by":[]}
{"uid":"headers/wm_dock.h::wm_dock_mag_size","name":"wm_dock_mag_size","qualname":"wm_dock_mag_size","kind":"function","file":"headers/wm_dock.h","line":78,"end_line":98,"language":"h","signature":"static inline int wm_dock_mag_size(const wm_dock_config_t *cfg, long dist, int level)","params":[{"name":"cfg","annotation":"wm_dock_config_t *","default":"","kind":"positional"},{"name":"dist","annotation":"long","default":"","kind":"positional"},{"name":"level","annotation":"int","default":"","kind":"positional"}],"returns":"int","decorators":[],"bases":[],"modifiers":["inline","static"],"visibility":"public","doc":{"summary":"Docstring: Size of an icon whose centre lies dist pixels from the pointer, at the given level.","description":"The bell is (1 - t^2)^2 with t = dist / reach: peak under the pointer, base at the reach and beyond, smooth at both ends, symmetric in the sign of dist. The level scales the growth linearly. Returns base on a degenerate configuration, 0 on a null one.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"headers/wm_dock.h","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":["headers/wm_dock.h::wm_dock_abs","headers/wm_dock.h::wm_dock_level_clamp"],"called_by":[]}
{"uid":"headers/wm_dock.h::wm_dock_src_coord","name":"wm_dock_src_coord","qualname":"wm_dock_src_coord","kind":"function","file":"headers/wm_dock.h","line":104,"end_line":113,"language":"h","signature":"static inline long wm_dock_src_coord(int o, int d, int s)","params":[{"name":"o","annotation":"int","default":"","kind":"positional"},{"name":"d","annotation":"int","default":"","kind":"positional"},{"name":"s","annotation":"int","default":"","kind":"positional"}],"returns":"long","decorators":[],"bases":[],"modifiers":["inline","static"],"visibility":"public","doc":{"summary":"Docstring: Source coordinate, in 8.8 fixed point, that destination pixel o of a d-pixel span maps to in an s-texel span.","description":"Pixel centres are aligned, so a 1:1 scale maps every pixel onto its own texel, and the result is clamped to the first and last texel centre.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"headers/wm_dock.h","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":["headers/wm_dock.h::wm_dock_sample"]}
{"uid":"headers/wm_dock.h::wm_dock_sample","name":"wm_dock_sample","qualname":"wm_dock_sample","kind":"function","file":"headers/wm_dock.h","line":120,"end_line":168,"language":"h","signature":"static inline unsigned long wm_dock_sample(const unsigned char *rgba, int sw, int sh, int dw, int dh, int ox, int oy, int *alpha)","params":[{"name":"rgba","annotation":"unsigned char *","default":"","kind":"positional"},{"name":"sw","annotation":"int","default":"","kind":"positional"},{"name":"sh","annotation":"int","default":"","kind":"positional"},{"name":"dw","annotation":"int","default":"","kind":"positional"},{"name":"dh","annotation":"int","default":"","kind":"positional"},{"name":"ox","annotation":"int","default":"","kind":"positional"},{"name":"oy","annotation":"int","default":"","kind":"positional"},{"name":"alpha","annotation":"int *","default":"","kind":"positional"}],"returns":"unsigned long","decorators":[],"bases":[],"modifiers":["inline","static"],"visibility":"public","doc":{"summary":"Docstring: Bilinear sample of destination pixel (ox,oy) of an sw by sh RGBA source scaled to dw by dh.","description":"Colours are weighted by alpha, so a transparent texel never darkens the edge of an opaque one. Returns the packed 0x00RRGGBB colour and stores the coverage 0..255 in alpha; a degenerate call returns 0 with alpha 0.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"headers/wm_dock.h","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":["headers/wm_dock.h::wm_dock_src_coord"],"called_by":[]}
