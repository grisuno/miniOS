{"uid":"headers/seccomp_bpf.h::sbpf_check","name":"sbpf_check","qualname":"sbpf_check","kind":"function","file":"headers/seccomp_bpf.h","line":95,"end_line":95,"language":"h","signature":"int sbpf_check(const sbpf_insn *prog, unsigned len, unsigned short *scratch);","params":[{"name":"prog","annotation":"sbpf_insn *","default":"","kind":"positional"},{"name":"len","annotation":"unsigned","default":"","kind":"positional"},{"name":"scratch","annotation":"unsigned short *","default":"","kind":"positional"}],"returns":"int","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Validate a program before it ever runs: 1..SBPF_MAX_INSNS instructions, only the opcodes Linux accepts for seccomp, word loads inside seccomp_data at aligned offsets, scratch indices below SBPF_MEMWORDS, no constant zero divisor or modulus, constant shifts below 32, every jump landing inside the program, no scratch word read before every path wrote it, and a RET last. scratch must hold len entries (the per-pc initialized-scratch masks).","description":"0 when valid, SBPF_ERR_INVALID otherwise.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"headers/seccomp_bpf.h","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
{"uid":"headers/seccomp_bpf.h::sbpf_run","name":"sbpf_run","qualname":"sbpf_run","kind":"function","file":"headers/seccomp_bpf.h","line":100,"end_line":100,"language":"h","signature":"unsigned int sbpf_run(const sbpf_insn *prog, unsigned len, const sbpf_data *d);","params":[{"name":"prog","annotation":"sbpf_insn *","default":"","kind":"positional"},{"name":"len","annotation":"unsigned","default":"","kind":"positional"},{"name":"d","annotation":"sbpf_data *","default":"","kind":"positional"}],"returns":"unsigned int","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Run a program sbpf_check accepted over one syscall's data; returns the 32-bit action.","description":"A runtime division or modulus by a zero X returns SBPF_RET_KILL_PROCESS.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"headers/seccomp_bpf.h","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":["kernel/proc_sec.c::proc_sec_filter"]}
{"uid":"headers/seccomp_bpf.h::sbpf_action_rank","name":"sbpf_action_rank","qualname":"sbpf_action_rank","kind":"function","file":"headers/seccomp_bpf.h","line":104,"end_line":104,"language":"h","signature":"int sbpf_action_rank(unsigned int action);","params":[{"name":"action","annotation":"unsigned int","default":"","kind":"positional"}],"returns":"int","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Restrictiveness rank of an action (0 = most restrictive): the order stacked filters are combined in.","description":"Unknown actions rank as KILL_PROCESS.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"headers/seccomp_bpf.h","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":["kernel/proc_sec.c::proc_sec_filter"]}
