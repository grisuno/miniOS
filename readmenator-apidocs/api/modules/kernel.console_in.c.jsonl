{"uid":"kernel/console_in.c::MAX_SEQ_POLL","name":"MAX_SEQ_POLL","qualname":"MAX_SEQ_POLL","kind":"macro","file":"kernel/console_in.c","line":159,"end_line":168,"language":"c","signature":"#define MAX_SEQ_POLL","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Docstring: Poll for the next raw byte with a bounded spin, so a multi-byte escape sequence arriving over the serial line (byte by byte) is read as a unit.","description":"Returns the byte, or -1 after MAX_SEQ_POLL polls. The bound keeps a bare ESC (never completed into a sequence) from hanging the reader.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"kernel/console_in.c","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
{"uid":"kernel/console_in.c::console_history_page","name":"console_history_page","qualname":"console_history_page","kind":"function","file":"kernel/console_in.c","line":204,"end_line":210,"language":"c","signature":"void console_history_page(int dir)","params":[{"name":"dir","annotation":"int","default":"","kind":"positional"}],"returns":"void","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Docstring: Page the console history by one screen (dir -1 up, +1 down).","description":"The framebuffer terminal keeps its own logical ring, the text-mode console the legacy VGA scrollback ring; this picks the one that is up and is the single entry point for the page keys.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"kernel/console_in.c","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":["headers/vga_fb.h::vga_fb_history_page"],"called_by":["kernel/console_in.c::console_getc"]}
