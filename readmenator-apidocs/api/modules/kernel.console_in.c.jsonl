{"uid":"kernel/console_in.c::console_peek","name":"console_peek","qualname":"console_peek","kind":"function","file":"kernel/console_in.c","line":247,"end_line":252,"language":"c","signature":"int console_peek(void)","params":[],"returns":"int","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Docstring: Next buffered byte without consuming it, or -1 when nothing is available right now.","description":"Used to tell an ESC prefix from a complete escape sequence, which always arrives in one burst. Global so SYS_SPAWN waits in spawn.c can poll for Ctrl+C exactly like the shell foreground wait does.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"kernel/console_in.c","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
{"uid":"kernel/console_in.c::console_raw_try","name":"console_raw_try","qualname":"console_raw_try","kind":"function","file":"kernel/console_in.c","line":260,"end_line":262,"language":"c","signature":"int console_raw_try(void)","params":[],"returns":"int","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Docstring: Raw console multiplexer for the GETC_RAW syscall.","description":"The same serial + PS/2 sources console_getc funnels, but without the line buffering, echo or scrollback detour: a ring-3 fullscreen program reads keystrokes byte by byte. Blocking spins with a pause (and the desktop tick, as the shell idle loop does); the try variant returns -1 when nothing is available so user space can implement its own timeout.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"kernel/console_in.c","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
