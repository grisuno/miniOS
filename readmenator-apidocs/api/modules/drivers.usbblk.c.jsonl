{"uid":"drivers/usbblk.c::ubk_build_cbw","name":"ubk_build_cbw","qualname":"ubk_build_cbw","kind":"function","file":"drivers/usbblk.c","line":92,"end_line":119,"language":"c","signature":"void ubk_build_cbw(unsigned char *out, unsigned tag, unsigned long lba, unsigned blocks, int read, int data_len)","params":[{"name":"out","annotation":"unsigned char *","default":"","kind":"positional"},{"name":"tag","annotation":"unsigned","default":"","kind":"positional"},{"name":"lba","annotation":"unsigned long","default":"","kind":"positional"},{"name":"blocks","annotation":"unsigned","default":"","kind":"positional"},{"name":"read","annotation":"int","default":"","kind":"positional"},{"name":"data_len","annotation":"int","default":"","kind":"positional"}],"returns":"void","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Docstring: Build a Command Block Wrapper into out, which must have room for UBK_CBW_LEN bytes.","description":"Pure, for the host test: a CBW whose fields disagree with its arguments is a command the device must reject, and getting the residue wrong makes a short write look complete.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[["Inherited","Documentation from `ubk_build_cbw` (headers/drivers/usbblk.h:52)."]],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"drivers/usbblk.c","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
