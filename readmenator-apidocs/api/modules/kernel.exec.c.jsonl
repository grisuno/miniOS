{"uid":"kernel/exec.c::EXEC_KSTACK_SZ","name":"EXEC_KSTACK_SZ","qualname":"EXEC_KSTACK_SZ","kind":"macro","file":"kernel/exec.c","line":124,"end_line":231,"language":"c","signature":"#define EXEC_KSTACK_SZ","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Kernel stack the exec frame runs on.","description":"It must hold both the ring-3 program's syscall frames and any ring-0 ET_REL child it spawns through SYS_SPAWN (the toolchain's minigcc/ld recurse deeply), so it is larger than the per-proc scheduler slot: a child that overflowed the old 32 KB wrote past its stack into adjacent kernel-heap page tables and made pt_free_user spin on the corrupted entries.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"kernel/exec.c","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
{"uid":"kernel/exec.c::ETREL_CHILD_STACK_SZ","name":"ETREL_CHILD_STACK_SZ","qualname":"ETREL_CHILD_STACK_SZ","kind":"macro","file":"kernel/exec.c","line":133,"end_line":231,"language":"c","signature":"#define ETREL_CHILD_STACK_SZ","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"ET_REL child stack: the toolchain recurses deeper than any fixed small slot.","description":"Measured need is a 66 KB single frame in minigcc's parse_function, so 64 KB (the old EXEC_KSTACK_SZ and every 16 KB proc slot) overflows it: silently into pool neighbours from an isolated window (the lost MiniFS mount), by luck nowhere fatal from the shell. 256 KB is transient per spawn and leaves headroom for nesting.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"kernel/exec.c","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":["headers/arch/x86/msr.h::wrmsr","headers/drivers/kbd.h::kbd_reset_for_shell","headers/kernel.h::k_exec_user","headers/kernel.h::ksetjmp","headers/proc_sec.h::proc_sec_release","headers/sched.h::aslr_stack_bytes","headers/sched.h::pt_clone_user","headers/sched.h::pt_free_user","headers/vga_fb.h::vga_fb_draw_desktop","headers/vga_fb.h::vga_fb_set_gfx_mode","kernel/exec.c::setup_user_stack"],"called_by":[]}
