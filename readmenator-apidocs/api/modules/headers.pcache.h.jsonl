{"uid":"headers/pcache.h::pcache_get","name":"pcache_get","qualname":"pcache_get","kind":"function","file":"headers/pcache.h","line":42,"end_line":42,"language":"h","signature":"int pcache_get(int ino, unsigned index, int *is_new);","params":[{"name":"ino","annotation":"int","default":"","kind":"positional"},{"name":"index","annotation":"unsigned","default":"","kind":"positional"},{"name":"is_new","annotation":"int *","default":"","kind":"positional"}],"returns":"int","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Docstring: Get a page, pinned with one ref.","description":"Hit returns the live slot; miss reserves an empty or evicted slot (ref 1, clean, *is_new 1, data uninitialized: the caller fills it before any reader sees it) or -1 when every slot is pinned or the pool is disabled, in which case the caller falls back to direct block I/O, fail-open correct. Racy fills must use publish below, never a reserved-then-filled get: a concurrent faulter would map the half-written page.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"headers/pcache.h","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
