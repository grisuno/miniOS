{"uid":"kernel/futex.c::futex_forget","name":"futex_forget","qualname":"futex_forget","kind":"function","file":"kernel/futex.c","line":76,"end_line":88,"language":"c","signature":"void futex_forget(int pid)","params":[{"name":"pid","annotation":"int","default":"","kind":"positional"}],"returns":"void","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Docstring: Drop pid from the futex queues (see futex.h).","description":"A thread that dies or is killed while waiting stays queued; once its slot is reused the stale node aliases the new thread, and the new thread queueing behind itself linked tail -> tail, a cycle futex_wake spun on forever. Called before every wait and when a slot is reaped.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"kernel/futex.c","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":["headers/spinlock.h::spin_lock_irqsave","headers/spinlock.h::spin_unlock_irqrestore"],"called_by":[]}
