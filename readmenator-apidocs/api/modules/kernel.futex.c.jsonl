{"uid":"kernel/futex.c::futex_wake","name":"futex_wake","qualname":"futex_wake","kind":"function","file":"kernel/futex.c","line":158,"end_line":198,"language":"c","signature":"long futex_wake(unsigned long uaddr, int n)","params":[{"name":"uaddr","annotation":"unsigned long","default":"","kind":"positional"},{"name":"n","annotation":"int","default":"","kind":"positional"}],"returns":"long","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Docstring: Wake up to n sleepers waiting on uaddr.","description":"Only entries whose recorded address equals uaddr change state; hash\ncollisions sleep through. Entries that no longer sleep (a waiter that\ndied or was killed in the queue) are unlinked on the way. The walk is\nbounded by MAX_PROCS. Returns the number of threads woken, zero when\nthe bucket holds no waiter for this address. Never sleeps.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"kernel/futex.c","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":["headers/spinlock.h::spin_lock_irqsave","headers/spinlock.h::spin_unlock_irqrestore"],"called_by":[]}
