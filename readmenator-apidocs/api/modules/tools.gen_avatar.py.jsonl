{"uid":"tools/gen_avatar.py","name":"gen_avatar.py","qualname":"tools/gen_avatar.py","kind":"module","file":"tools/gen_avatar.py","line":1,"end_line":246,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Generate the desktop profile avatar as a C header.","description":"Purpose\n    Draws a stylized anime-style portrait with vector primitives at a high\n    supersampling factor, downsamples it with a Lanczos filter and writes\n    the pixels as a packed 0x00RRGGBB array that the kernel blits inside a\n    circular mask (headers/avatar_data.h). The artwork is procedural, so the\n    repository ships no third-party image and the portrait can be tuned by\n    editing AvatarConfig.\n\nUsage\n    python3 tools/gen_avatar.py [--out headers/avatar_data.h] [--preview png]\n\nInputs\n    None. All tunables live in AvatarConfig.\n\nOutputs\n    A header defining AVATAR_SIZE and the avatar_pixels array, and with\n    --preview a PNG of the same pixels for review.\n\nFailure modes\n    Missing Pillow aborts with a clear message; an unwritable output path\n    aborts with the OS error. The output is written atomically through a\n    temporary file in the same directory, never left half written.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["tools/gen_avatar.py::AvatarConfig","tools/gen_avatar.py::AvatarPainter","tools/gen_avatar.py::load_portrait","tools/gen_avatar.py::parse_crop","tools/gen_avatar.py::write_header","tools/gen_avatar.py::main"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
