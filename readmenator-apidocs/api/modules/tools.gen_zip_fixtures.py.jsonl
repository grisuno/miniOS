{"uid":"tools/gen_zip_fixtures.py","name":"gen_zip_fixtures.py","qualname":"tools/gen_zip_fixtures.py","kind":"module","file":"tools/gen_zip_fixtures.py","line":1,"end_line":59,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"gen_zip_fixtures.py -- generate the zip test fixtures shipped on the ramdisk.","description":"Two small ZIP archives, built with the host's standard zipfile so the in-OS\nextractor is tested against bytes produced by a reference implementation, not\njust by its own writer:\n\n  host.zip    a well-formed archive with a directory and two files, proving\n              the in-OS extractor interops with host-produced ZIPs.\n\n  hostile.zip an archive whose entry names try to escape the extraction\n              root: a traversal (\"../escape.txt\"), an absolute path\n              (\"/abs.txt\") and a directory marker (\"dir/\") beside one plain\n              file.  The in-OS extractor must create only good.txt, dir/ and\n              abs.txt (the absolute name is sanitized to relative) and must\n              never create escape.txt.\n\nTimestamps are fixed so the build is reproducible.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["tools/gen_zip_fixtures.py::FIXED_TIME","tools/gen_zip_fixtures.py::write_zip","tools/gen_zip_fixtures.py::main"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
